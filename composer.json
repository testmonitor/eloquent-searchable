{
    "name": "testmonitor/eloquent-searchable",
    "description": "A Laravel package that adds search functionality to Eloquent models, allowing for various search techniques such as exact and partial matches.",
    "type": "library",
    "keywords": [
        "testmonitor",
        "search",
        "eloquent",
        "model",
        "laravel"
    ],
    "authors": [
        {
            "name": "Thijs Kok",
            "email": "thijs.kok@cerios.com",
            "homepage": "https://www.testmonitor.com/",
            "role": "Lead Developer"
        },
        {
            "name": "Stephan Grootveld",
            "email": "stephan.grootveld@cerios.com",
            "homepage": "https://www.testmonitor.com/",
            "role": "Developer"
        },
        {
            "name": "Frank Keulen",
            "email": "frank.keulen@cerios.com",
            "homepage": "https://www.testmonitor.com/",
            "role": "Developer"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/config": "^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "rector/rector": "^2.6"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "TestMonitor\\Searchable\\": "src",
            "TestMonitor\\Searchable\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestMonitor\\Searchable\\Test\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "style": "vendor/bin/pint --test",
        "sniff": "vendor/bin/phpcs",
        "refactor": "vendor/bin/rector process --dry-run",
        "test": "vendor/bin/phpunit --no-coverage",
        "check": [
            "@style",
            "@sniff",
            "@analyse",
            "@refactor",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "TestMonitor\\Searchable\\SearchableServiceProvider"
            ]
        }
    },
    "prefer-stable": true,
    "license": "MIT"
}
